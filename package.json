{
  "name": "jspoofer",
  "version": "2.0.0",
  "description": "Animation spoofing utility for Roblox Studio",
  "author": "Jonuffy",
  "license": "GPL-3.0-or-later",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "plugin": "node scripts/build-plugin.js",
    "icon": "node scripts/build-icon.mjs",
    "test": "node --test \"test/**/*.test.js\"",
    "prebuild": "npm run plugin",
    "build": "electron-builder"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "png-to-ico": "^3.0.2",
    "pngjs": "^7.0.0"
  },
  "build": {
    "appId": "com.github.jonuffykk.jSpoofer",
    "productName": "jSpoofer",
    "artifactName": "jSpoofer-${version}.${ext}",
    "forceCodeSigning": false,
    "files": [
      "main.js",
      "preload.js",
      "src/main/**/*",
      "src/renderer/**/*",
      "assets/**/*",
      "package.json",
      "!**/.git/**/*",
      "!dist/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "dist/jSpoofer-v${version}.rbxmx",
        "to": "jSpoofer-v${version}.rbxmx"
      }
    ],
    "win": {
      "target": "portable",
      "icon": "assets/logo.ico",
      "signAndEditExecutable": false
    },
    "publish": {
      "provider": "github",
      "owner": "jonuffykk",
      "repo": "jSpoofer"
    }
  }
}
